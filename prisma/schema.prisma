generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("client") // client, admin, livreur
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries      Delivery[]
  invoices        Invoice[]
  company         Company?
  notifications   Notification[]
  payments        Payment[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  nif       String?
  rccm      String?
  address   String?
  sector    String?
  email     String?
  phone     String?
  plan      String   @default("decouverte") // decouverte, business, premium
  planLimit Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  invoices   Invoice[]
}

model Livreur {
  id       String   @id @default(cuid())
  name     String
  phone    String
  vehicle  String
  zone     String
  rating   Float    @default(4.5)
  status   String   @default("disponible") // disponible, en_course, pause, hors_service
  coursesDone Int  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]
}

model Delivery {
  id        String   @id @default(cuid())
  reference String   @unique
  type      String   @default("standard") // standard, express, inter-arrondissement
  status    String   @default("en_attente") // en_attente, prise_en_charge, en_course, livre, annulee
  priority  String   @default("normale") // normale, haute, urgente
  pickup    String
  dropoff   String
  recipientName  String?
  recipientPhone String?
  description    String?
  instructions   String?
  paymentMode    String   @default("forfait") // forfait, mobile_money, virement
  price     Int      @default(2500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId  String?
  client    User?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  livreurId String?
  livreur   Livreur? @relation(fields: [livreurId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  timeline  Timeline[]
}

model Timeline {
  id        String   @id @default(cuid())
  event     String   // commande_creee, pris_en_charge, en_livraison, livre, annulee
  comment   String?
  timestamp DateTime @default(now())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // new_delivery, status_change, payment, system
  title     String
  message   String
  read      Boolean  @default(false)
  link      String? // optional deep link e.g. /suivi?ref=CMD-xxx
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  transactionId  String   @unique
  provider       String   // airtel_money, moov_money
  phoneNumber    String
  amount         Int
  status         String   @default("en_cours") // en_cours, reussi, echoue
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(cuid())
  reference String   @unique
  period    String
  amount    Int
  coursesCount Int
  status    String   @default("en_attente") // en_attente, payee, en_retard
  paidDate  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId  String?
  client    User?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deliveries Delivery[]
  payments   Payment[]
}
